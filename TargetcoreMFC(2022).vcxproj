  <!-- All three siblings are consumed as an include path plus an import library,
       never as a linked project output: LinkLibraryDependencies is false, so the
       explicit .lib list in <AdditionalDependencies> stays the one that is linked.
       The references exist to ORDER the build, so a stale sibling can no longer be
       linked silently. They also repair the 32-bit build: Targetcore had never been
       built for Win32, so Debug|x86 and Release|x86 failed with LNK1104 on
       Targetcore.lib until these references started producing it.

       ShouldUnsetParentConfigurationAndPlatform, set false above, is required for
       these to work. A solution build defaults it true, which strips Configuration
       and Platform from the global properties the referenced project sees, so it
       evaluates MSCS\Directory.Build.props with both empty. That file appends the
       platform and configuration to $(WDMSCS_LIB) only when BOTH are set, so the
       sibling writes its import library to MSCS\lib\<name>.lib (the un-suffixed
       root, the very failure Directory.Build.props exists to prevent) and a
       -t:Rebuild first CLEANS the correct per-configuration copy. -->
  <ItemGroup>
    <ProjectReference Include="..\Msgcore\Msgcore(2022).vcxproj">
      <Project>{c1e33b10-d6ce-44be-8f98-080196bc682b}</Project>
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=$(Platform)</SetPlatform>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
    </ProjectReference>
    <ProjectReference Include="..\Targetcore\Targetcore(2022).vcxproj">
      <Project>{dd78ae5d-9a41-4004-84ff-0106b45f5d18}</Project>
